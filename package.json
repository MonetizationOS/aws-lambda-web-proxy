{
    "name": "aws-lambda-web-proxy",
    "version": "0.0.0",
    "private": true,
    "description": "MonetizationOS proxy for AWS Lambda Web Functions behind CloudFront",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MonetizationOS/aws-lambda-web-proxy.git"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "node scripts/build.mjs",
        "test": "vitest run",
        "e2e": "pnpm run build && node test/e2e.mjs",
        "start": "node build/index.js",
        "lint": "biome check --diagnostic-level=error --no-errors-on-unmatched",
        "format": "biome check --write --no-errors-on-unmatched"
    },
    "dependencies": {
        "@monetizationos/proxy": "1.7.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.15",
        "@types/node": "^25.9.1",
        "esbuild": "^0.28.0",
        "typescript": "^6.0.3",
        "undici": "^7.16.0",
        "vitest": "^4.1.7"
    }
}
