{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["node"],
        "paths": {
            "cloudflare:test": ["./test/shims/cloudflareTest.ts"],
            "cloudflare:workers": ["./test/shims/cloudflareWorkers.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"]
}
